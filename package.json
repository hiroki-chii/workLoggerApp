{
  "name": "workloggerapp",
  "version": "1.0.0",
  "description": "",
  "main": "electron-core/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"wait-on http://127.0.0.1:5173 && npm run dev:electron\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "npx electron electron-core/main.js",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend && electron-builder",
    "test": "set ELECTRON_RUN_AS_NODE=1&& electron --test test/activity-state.test.js test/time-range.test.js test/screen-data.test.mjs test/server-integration.test.js test/collector-integration.test.js test/monitor-helper.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "csv-stringify": "^6.7.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "balanced-match": "^4.0.4",
    "concurrently": "^9.2.1",
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.workloggerapp.app",
    "productName": "ゆとリズム",
    "compression": "normal",
    "electronLanguages": [
      "ja",
      "en-US"
    ],
    "directories": {
      "output": "dist-pulse"
    },
    "files": [
      "electron-core/**/*",
      "backend/**/*",
      "!backend/monitor.ps1",
      "frontend/dist/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/binding.gyp"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/build/Release/*.node"
    ],
    "extraResources": [
      {
        "from": "backend/monitor.ps1",
        "to": "monitor.ps1"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
